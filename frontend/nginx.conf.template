# Behind a proxy we control (Caddy) keep the client address it gives us; otherwise use the connecting address.
map $http_x_forwarded_for $dt_forwarded_for {
    default $http_x_forwarded_for;
    ""      $remote_addr;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" always;

    location /api/ {
        proxy_pass http://api:8000/;
        # The browser sends its own sign-in (X-API-Key for a lender, X-Claim-Token for a customer); nothing is added here.
        proxy_set_header X-Forwarded-For $dt_forwarded_for;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri /index.html;
    }
}
