# DecisionTrace Environment Configuration (No secrets in git)
ENV=dev

# PostgreSQL 15 Connection
POSTGRES_USER=decisiontrace
POSTGRES_PASSWORD=decisiontrace_local_dev
POSTGRES_DB=decisiontrace
POSTGRES_PORT=5433
DB_URL=postgresql://decisiontrace:decisiontrace_local_dev@localhost:5433/decisiontrace
APP_DB_URL=postgresql://app_role:app_role_local_dev@localhost:5433/decisiontrace

# Swappable Backends (gemini_api | fake, local)
LLM_BACKEND=fake
SEARCH_BACKEND=local
STORAGE_BACKEND=local

# Gemini & Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MODEL_VERSION=loan_lr_v1

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:8000
VITE_USE_MOCKS=false


# API hardening (all optional)
# DT_API_KEY=dev-demo-key # admin key for the built-in 'demo' tenant; every endpoint needs an X-API-Key
# VITE_API_KEY=dev-demo-key  # same value, for the Vite dev server only (the Docker proxy adds it server-side)
# DT_ID_SECRET=           # required outside ENV=dev; makes ingest decision IDs unguessable
# CORS_ORIGINS=http://localhost:5173
# RECON_RATE_LIMIT_PER_MINUTE=20
# RECON_CACHE_TTL_SECONDS=60
# DT_ANCHOR_LOG=./anchors.jsonl   # external chain-head anchor log
# DT_ANCHOR_KEY=                  # HMAC key for anchor entries
# DT_AUTO_MIGRATE=1       # update the database on API start (default on when ENV=dev; the screens need the newest tables)
# DT_AUTH_FAIL_LIMIT=20   # wrong keys or links per client per minute before they are slowed down
# DT_TRUST_PROXY=1        # only behind a proxy you control: use X-Forwarded-For as the client address
# DT_SEAL_KEY=            # base64, 32 bytes: signs record seals (required outside ENV=dev)
# DT_SEAL_PUBLISH_DIR=    # a directory the database administrator cannot rewrite: signed seals are copied here
# DT_MASTER_KEY=          # base64, 32 bytes: protects evidence for lenders with protection on (required outside ENV=dev)
# DT_KEK_VERSION=1        # which lender-key version new data keys are wrapped with
# DT_DB_POOL_SIZE=0       # 0 = a new database connection per request; N = reuse up to N per worker
