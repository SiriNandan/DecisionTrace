# Template for /etc/decisiontrace/app.env on the VM (root-only, mode 600). Values are generated on the VM or pulled
# from Secret Manager; never commit the real file.
ENV=production
DT_DOMAIN=                 # e.g. 203.0.113.7.sslip.io
CORS_ORIGINS=              # https://<DT_DOMAIN>
POSTGRES_USER=decisiontrace
POSTGRES_DB=decisiontrace
POSTGRES_PASSWORD=         # generated
DT_API_KEY=                # generated: the demo lender's admin key, typed into the sign-in screen
DT_ID_SECRET=              # generated, at least 16 characters
DT_SEAL_KEY=               # generated: base64 of 32 random bytes (openssl rand -base64 32)
DT_MASTER_KEY=             # generated: base64 of 32 random bytes
DT_ANCHOR_KEY=             # generated
