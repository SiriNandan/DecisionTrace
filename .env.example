# DecisionTrace Environment Configuration (No secrets in git)
ENV=dev

# PostgreSQL 15 Connection
POSTGRES_USER=decisiontrace
POSTGRES_PASSWORD=decisiontrace_local_dev
POSTGRES_DB=decisiontrace
POSTGRES_PORT=5433
DB_URL=postgresql://decisiontrace:decisiontrace_local_dev@localhost:5433/decisiontrace
APP_DB_URL=postgresql://app_role:app_role_local_dev@localhost:5433/decisiontrace

# Swappable Backends (gemini_api | fake, local)
LLM_BACKEND=fake
SEARCH_BACKEND=local
STORAGE_BACKEND=local

# Gemini & Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MODEL_VERSION=loan_lr_v1

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:8000
VITE_USE_MOCKS=false

