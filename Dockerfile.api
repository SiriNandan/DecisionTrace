# Decision API + reconstruction agent (same image, different command). Synthetic data only.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend ./backend
COPY data ./data
COPY decision_api ./decision_api
COPY recon_agent ./recon_agent
COPY migrations ./migrations
COPY policies ./policies
COPY docs ./docs
RUN useradd --system --uid 10001 app && mkdir -p /var/dt/anchors /var/dt/seals && chown -R app /app/docs /app/data /var/dt
USER app
EXPOSE 8000
CMD ["uvicorn", "decision_api.app:app", "--host", "0.0.0.0", "--port", "8000"]
